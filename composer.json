{
    "name": "trilbdev/two-factor-library",
    "description": "A PHP 2FA library for TOTP, QR codes, passkeys, and recovery codes.",
    "type": "library",
    "homepage": "https://trilb.dev/catalog/libraries/two-factor-library",
    "keywords": [ "Authentication", "Two Factor Authentication", "Multi Factor Authentication", "TFA", "MFA", "PHP", "Authenticator", "Authy" ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Trilbdev\\TwoFactorLibrary\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Anthony Bluthner",
            "homepage": "https://trilb.dev",
            "email": "anthony.bluthner@outlook.com"
        }
    ],
    "support": {
        "issues": "https://github.com/TrilB-Dev/two-factor-library/issues",
        "source": "https://github.com/TrilB-Dev/two-factor-library"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11",
        "friendsofphp/php-cs-fixer": "^3.13",
        "phpstan/phpstan": "^1.9"
    },
     "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "phpstan": [
            "phpstan analyze --xdebug lib tests testsDependency"
        ],
        "lint": [
            "php-cs-fixer fix -v"
        ],
        "lint-ci": [
            "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix -v --dry-run --stop-on-violation"
        ],
        "test": [
            "XDEBUG_MODE=coverage phpunit"
        ]
    }
}